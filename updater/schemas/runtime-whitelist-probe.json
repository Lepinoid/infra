{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime whitelist probe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "probe", "startedAt", "runtimeBefore"],
  "properties": {
    "schemaVersion": {"const": 1},
    "transactionId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "probe": {"const": "runtime-whitelist"},
    "startedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "runtimeBefore": {"type": ["boolean", "null"]}
  }
}
