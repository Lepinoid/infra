{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "current",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "ociRepository", "digest", "pluginCommitSha", "lepinoidToolsSha256", "multiverseSha256", "multiverseVersion", "supportedMinecraft", "configMapResourceVersion", "installedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string"},
    "ociRepository": {"const": "ghcr.io/lepinoid/lepinoid-tools"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pluginCommitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lepinoidToolsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "multiverseSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "multiverseVersion": {"type": "string"},
    "supportedMinecraft": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "configMapResourceVersion": {"type": "string"},
    "installedAt": {"type": "string", "format": "date-time"}
  }
}
