# HELP neuralwatt_account_info Account information. Always 1.
# TYPE neuralwatt_account_info gauge
neuralwatt_account_info{accounting_method="energy",rate_limit_tier="standard"} 1
# HELP neuralwatt_credits_remaining_usd Current USD credit balance (balance.credits_remaining_usd).
# TYPE neuralwatt_credits_remaining_usd gauge
neuralwatt_credits_remaining_usd 32.6774
# HELP neuralwatt_exporter_fetch_duration_seconds Duration of the latest fetch attempt. Absent until the first fetch finishes.
# TYPE neuralwatt_exporter_fetch_duration_seconds gauge
neuralwatt_exporter_fetch_duration_seconds 0.25
# HELP neuralwatt_exporter_fetch_success 1 if the latest fetch of /v1/quota succeeded, 0 if it failed. Absent until the first fetch finishes.
# TYPE neuralwatt_exporter_fetch_success gauge
neuralwatt_exporter_fetch_success 1
# HELP neuralwatt_exporter_fetches_total Fetch attempts of /v1/quota by result.
# TYPE neuralwatt_exporter_fetches_total counter
neuralwatt_exporter_fetches_total{result="client_error"} 0
neuralwatt_exporter_fetches_total{result="credential_error"} 0
neuralwatt_exporter_fetches_total{result="invalid_response"} 0
neuralwatt_exporter_fetches_total{result="network_error"} 0
neuralwatt_exporter_fetches_total{result="ok"} 1
neuralwatt_exporter_fetches_total{result="payment_required"} 0
neuralwatt_exporter_fetches_total{result="rate_limited"} 0
neuralwatt_exporter_fetches_total{result="server_error"} 0
neuralwatt_exporter_fetches_total{result="unauthorized"} 0
# HELP neuralwatt_exporter_last_success_timestamp_seconds Unix time of the last successful fetch. 0 if no fetch has succeeded yet.
# TYPE neuralwatt_exporter_last_success_timestamp_seconds gauge
neuralwatt_exporter_last_success_timestamp_seconds 1.77636426025e+09
# HELP neuralwatt_key_allowance_blocked 1 if the API key is blocked because its limit was reached.
# TYPE neuralwatt_key_allowance_blocked gauge
neuralwatt_key_allowance_blocked{key_name="",period="daily"} 1
# HELP neuralwatt_key_allowance_limit_usd Spending limit of the API key in USD. Absent when the key has no limit.
# TYPE neuralwatt_key_allowance_limit_usd gauge
neuralwatt_key_allowance_limit_usd{key_name="",period="daily"} 10
# HELP neuralwatt_subscription_info Subscription information. Always 1. Absent without a subscription.
# TYPE neuralwatt_subscription_info gauge
neuralwatt_subscription_info{billing_interval="",plan="standard",status="trialing"} 1
# HELP neuralwatt_usage_cost_usd_total Usage cost in USD. current_month resets to 0 at a calendar month boundary.
# TYPE neuralwatt_usage_cost_usd_total counter
neuralwatt_usage_cost_usd_total{window="current_month"} 160.1463
# HELP neuralwatt_usage_requests_total Request count. current_month resets to 0 at a calendar month boundary.
