# HELP neuralwatt_exporter_fetch_duration_seconds Duration of the latest fetch attempt. Absent until the first fetch finishes.
# TYPE neuralwatt_exporter_fetch_duration_seconds gauge
neuralwatt_exporter_fetch_duration_seconds 0.25
# HELP neuralwatt_exporter_fetch_success 1 if the latest fetch of /v1/quota succeeded, 0 if it failed. Absent until the first fetch finishes.
# TYPE neuralwatt_exporter_fetch_success gauge
neuralwatt_exporter_fetch_success 0
# HELP neuralwatt_exporter_fetches_total Fetch attempts of /v1/quota by result.
# TYPE neuralwatt_exporter_fetches_total counter
neuralwatt_exporter_fetches_total{result="client_error"} 0
neuralwatt_exporter_fetches_total{result="credential_error"} 0
neuralwatt_exporter_fetches_total{result="invalid_response"} 0
neuralwatt_exporter_fetches_total{result="network_error"} 0
neuralwatt_exporter_fetches_total{result="ok"} 0
neuralwatt_exporter_fetches_total{result="payment_required"} 0
neuralwatt_exporter_fetches_total{result="rate_limited"} 0
neuralwatt_exporter_fetches_total{result="server_error"} 1
neuralwatt_exporter_fetches_total{result="unauthorized"} 0
# HELP neuralwatt_exporter_last_success_timestamp_seconds Unix time of the last successful fetch. 0 if no fetch has succeeded yet.
# TYPE neuralwatt_exporter_last_success_timestamp_seconds gauge
neuralwatt_exporter_last_success_timestamp_seconds 0
# HELP neuralwatt_monthly_budget_usd Configured monthly budget in USD (NEURALWATT_MONTHLY_BUDGET_USD). Absent when not configured.
# TYPE neuralwatt_monthly_budget_usd gauge
neuralwatt_monthly_budget_usd 20
